---
// <Reto ej="m03/suma" enunciado="…" /> — CONTENIDO.md §4
// Editor (CodeMirror + lang-rust) con ejemplos/<ej>.inicio.rs; se ejecuta en el Rust Playground (opt-in, con aviso)
// y se compara la salida con la de la solución (ejemplos/<ej>.rs), precalculada en el build.
import { Code } from '@astrojs/starlight/components';
import Consola from './interno/Consola.astro';
import { ejemplo, nombreArchivo } from '../lib/ejemplos';
import { mdEnLinea } from './islas/md';

interface Props { ej: string; enunciado: string }
const { ej, enunciado } = Astro.props;
const e = ejemplo(ej, 'Reto');
if (e.inicio === null) throw new Error(`<Reto ej="${ej}">: falta el código inicial «ejemplos/${e.id}.inicio.rs».`);
// Sin salida precalculada solo se admite una solución de plataforma "playground" (p. ej., con hilos): el navegador
// la ejecuta también en el Playground la primera vez que se comprueba y compara con esa salida real.
if (e.salida === null && e.plataforma !== 'playground') throw new Error(`<Reto ej="${ej}">: la solución no tiene salida precalculada (¿"debe_fallar" o plataforma "local"?).`);
if (e.stdin) throw new Error(`<Reto ej="${ej}">: el Rust Playground no admite stdin; un reto no puede usar "stdin" en su .json.`);
const datos = { id: e.id, inicio: e.inicio, esperado: e.salida, solucion: e.codigo };
---
<section class="rdc-reto not-content" data-reto aria-label="Reto">
  <p class="rdc-quiz-tipo">Reto · escribe código</p>
  <div class="rdc-reto-enunciado" set:html={mdEnLinea(enunciado)} />
  <div class="rdc-reto-editor" data-editor-reto>
    <pre class="rdc-reto-previo" data-previo><code>{e.inicio}</code></pre>
  </div>
  <div class="rdc-barra">
    <button type="button" class="rdc-boton" data-accion="comprobar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 4.5v15a1 1 0 0 0 1.5.86l12.2-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z" /></svg>
      Comprobar en el Playground
    </button>
    <button type="button" class="rdc-boton sutil" data-accion="reiniciar">Volver al código inicial</button>
    <span class="rdc-plataforma" data-intentos></span>
  </div>
  <p class="rdc-aviso-ext">Al comprobar, <strong>tu código se enviará a play.rust-lang.org</strong> (el Rust Playground oficial, un servicio externo) para compilarlo y ejecutarlo. Se supera si imprime exactamente lo mismo que la solución.</p>
  <div class="rdc-compilacion" data-compilacion hidden aria-live="polite"></div>
  <Consola />
  <div class="rdc-veredicto" data-veredicto aria-live="polite"></div>
  <details class="rdc-solucion" data-solucion hidden>
    <summary>Ver solución</summary>
    <Code code={e.codigo.replace(/\n$/, '')} lang="rust" title={`Solución · ${nombreArchivo(e)}`} />
  </details>
  <script type="application/json" data-datos set:html={JSON.stringify(datos).replace(/</g, '\\u003c')} />
</section>

<script>
  import { iniciarRetos } from '../runtime/reto-cliente';
  iniciarRetos();
</script>
