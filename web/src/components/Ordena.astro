---
// <Ordena lineas distractores? explicacion? /> — CONTENIDO.md §4 (problema de Parsons)
import OrdenaIsla from './islas/Ordena';
interface Props { lineas: string[]; distractores?: string[]; explicacion?: string; enunciado?: string }
const { lineas, distractores, explicacion, enunciado } = Astro.props;
---
