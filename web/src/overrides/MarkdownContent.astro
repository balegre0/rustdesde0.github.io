---
// En la portada de cada mundo (curso/<mundo>/index.mdx) la plataforma añade la lista de lecciones.
// En cada lección: arriba, lo previo que hay que recordar y la idea en una frase; abajo, explicarla con tus
// palabras y sus tarjetas para repasar de memoria;
// y los términos del glosario muestran su definición (src/runtime/glosario.ts).
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import ListaLecciones from '../components/interno/ListaLecciones.astro';
import LaClave from '../components/interno/LaClave.astro';
import RepasaSinMirar from '../components/interno/RepasaSinMirar.astro';
import AntesDeEmpezar from '../components/interno/AntesDeEmpezar.astro';
import ExplicaloTu from '../components/interno/ExplicaloTu.astro';
import { esLeccionId, esMundoId } from '../lib/lecciones';
const { id, entry } = Astro.locals.starlightRoute;
const mundo = esMundoId(id) ? id.replace(/^curso\//, '') : null;
const leccion = esLeccionId(id);
const d = entry.data as { frase?: string; imagina?: string; requiere?: string[]; tarjetas?: { p: string; r: string }[] };
---
<Default>
  {leccion && <AntesDeEmpezar requiere={d.requiere ?? []} />}
  {leccion && <LaClave frase={d.frase} imagina={d.imagina} />}
  <slot />
  {leccion && d.frase && <ExplicaloTu id={id.replace(/^curso\//, '')} frase={d.frase} />}
  {leccion && <RepasaSinMirar tarjetas={d.tarjetas ?? []} />}
  {mundo && <ListaLecciones mundo={mundo} />}
</Default>
{leccion && <script>import '../runtime/glosario';</script>}
